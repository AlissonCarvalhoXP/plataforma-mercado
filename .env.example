# .env.example
# Copie este arquivo para .env e preencha os valores reais
# NUNCA versionie o .env com dados sensíveis!

# ============================================================================
# BANCO DE DADOS
# ============================================================================
# Para SQLite local (desenvolvimento):
# DATABASE_URL=sqlite:///data/mercado.db

# Para PostgreSQL/Neon (produção):
# Exemplo de URL (substitua valores reais):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=postgresql://user:password@ep-xxxxxxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=sqlite:///data/mercado.db

# ============================================================================
# IA (Google Gemini)
# ============================================================================
# Gere em: https://aistudio.google.com/apikey
GEMINI_API_KEY=seu_api_key_aqui

# ============================================================================
# EMAIL (Gmail)
# ============================================================================
# Senha de APP (não senha da conta): https://myaccount.google.com/apppasswords
EMAIL_USER=seu_email@gmail.com
EMAIL_SENHA=sua_senha_de_app_aqui

# ============================================================================
# NOTAS DE SEGURANÇA
# ============================================================================
# 1. Este arquivo NÃO é versionado (.gitignore ignora .env)
# 2. Em produção (Streamlit Cloud), use Secrets: Settings > Secrets
# 3. Format do .env: NOME=valor (sem espaços, sem aspas)
# 4. Format do Secrets TOML: NOME = "valor" (com aspas)
# 5. Nunca commite credentials — use variáveis de ambiente
